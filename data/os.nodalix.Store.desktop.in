[Desktop Entry]
# Translators: Name of the application, translated like the stock apps of other
# systems (English "Store", Spanish "Tienda").
Name=Store
GenericName=App Store
Comment=Find, install and update software on Nodalix OS
Exec=nodalix-store-daemon %U
Icon=os.nodalix.Store
Terminal=false
Type=Application
Categories=GTK;Utility;
Keywords=System;Package;Manager;Discover;Flatpak;Software;App;Store;
StartupNotify=true
MimeType=x-scheme-handler/appstream;x-scheme-handler/flatpak;x-scheme-handler/flatpak+https;application/vnd.flatpak;application/vnd.flatpak.ref;application/x-freedesktop-appstream-component;
Actions=new-window;
X-Purism-FormFactor=Workstation;Mobile;

[Desktop Action new-window]
Name=New Window
Exec=nodalix-store-daemon %U
